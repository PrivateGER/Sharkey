{
	"name": "frontend-embed",
	"private": true,
	"type": "module",
	"scripts": {
		"watch": "node scripts/vue.ts vite",
		"watch:fast": "pnpm run watch",
		"build": "node scripts/vue.ts vite build",
		"build:pre": "pnpm run -w build-pre && pnpm run --filter misskey-js build && pnpm run --filter sw build && pnpm run --filter frontend-shared build",
		"typecheck-all": "pnpm run --no-bail typecheck:vue && pnpm run --no-bail typecheck:scripts",
		"typecheck": "pnpm run typecheck:vue && pnpm run typecheck:scripts",
		"typecheck:vue": "vue-tsc -p tsconfig.vue.json --noEmit",
		"typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
		"eslint": "eslint --quiet --cache -c eslint.config.js .",
		"lint": "pnpm typecheck && pnpm eslint"
	},
	"dependencies": {
		"@discordapp/twemoji": "16.0.1",
		"@phosphor-icons/web": "2.1.2",
		"buraha": "0.0.1",
		"frontend-shared": "workspace:*",
		"json5": "2.2.3",
		"locales": "workspace:*",
		"mfm-js": "npm:@transfem-org/sfm-js@0.26.1",
		"misskey-js": "workspace:*",
		"punycode.js": "2.3.1",
		"shiki": "4.5.0",
		"tinycolor2": "1.6.0",
		"uuid": "catalog:",
		"vue": "3.5.44"
	},
	"devDependencies": {
		"@misskey-dev/eslint-plugin": "2.2.1",
		"@misskey-dev/summaly": "npm:@transfem-org/summaly@5.2.3",
		"@rollup/plugin-json": "6.1.0",
		"@rollup/plugin-replace": "6.0.3",
		"@rollup/pluginutils": "5.4.0",
		"@testing-library/vue": "8.1.0",
		"@types/estree": "1.0.9",
		"@types/micromatch": "4.0.10",
		"@types/node": "catalog:",
		"@types/punycode.js": "npm:@types/punycode@2.1.4",
		"@types/tinycolor2": "1.4.6",
		"@typescript-eslint/eslint-plugin": "catalog:",
		"@typescript-eslint/parser": "catalog:",
		"@vitejs/plugin-vue": "6.0.10",
		"@vue/runtime-core": "3.5.44",
		"acorn": "8.19.0",
		"astring": "1.9.0",
		"cross-env": "10.1.0",
		"eslint": "catalog:",
		"eslint-plugin-import": "catalog:",
		"eslint-plugin-vue": "10.11.1",
		"estree-walker": "3.0.3",
		"fast-glob": "catalog:",
		"happy-dom": "21.0.1",
		"intersection-observer": "0.12.2",
		"micromatch": "4.0.8",
		"msw": "3.0.3",
		"nodemon": "3.1.14",
		"prettier": "3.6.2",
		"rollup": "catalog:",
		"sass": "1.105.1",
		"start-server-and-test": "2.1.3",
		"tsc-alias": "catalog:",
		"typescript": "catalog:",
		"vite": "7.3.7",
		"vite-plugin-turbosnap": "1.0.3",
		"vue-component-type-helpers": "3.3.13",
		"vue-eslint-parser": "10.4.1",
		"vue-tsc": "3.3.13"
	}
}
